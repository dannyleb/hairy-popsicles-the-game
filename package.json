    "album": "node tools/album.mjs",
    "itch": "node build.mjs && node tools/itch.mjs",
    "check": "npm run lint && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "potrace": "2.1.8",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=22"
  }
}
