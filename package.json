{
  "name": "hairy-popsicles-the-game",
  "version": "0.1.0",
  "description": "Hairy Popsicles: a hand-drawn, flat 2D, gross little browser game.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --serve",
    "lint": "eslint .",
